# ------------------------------------------------------------------------------
#  RCEMIP-I "RCE_small": radiative-convective equilibrium over a fixed-SST ocean
#  Doubly periodic, 96 km x 96 km, dx = 1 km, model top 33 km, SST = 300 K
#  Protocol: Wing et al. (2018), GMD 11, 793-813, doi:10.5194/gmd-11-793-2018
#
#  Companion files (see generate_rcemip_inputs.py):
#    input_sounding_rcemip_sst295/300/305 : analytic initial soundings
#  To run the 295 K / 305 K variants change: input_sounding_file,
#  most.surf_temp, most.surf_moist (qsat(SST): 0.016209 / 0.021953 / 0.029441),
#  and rad_t_sfc (and nothing else).
# ------------------------------------------------------------------------------
erf.prob_name = "RCEMIP"

stop_time = 8640000.0            # 100 days

fabarray.mfiter_tile_size = 1024 1024 1024

# PROBLEM SIZE & GEOMETRY
geometry.prob_lo = 0.      0.     0.
geometry.prob_hi = 96000. 96000. 33000.
amr.n_cell       = 96     96     105
amr.max_level    = 0

geometry.is_periodic = 1 1 0
zlo.type = "surface_layer"
zhi.type = "SlipWall"

# RCEMIP-style stretched vertical grid: dz = 50 m at the surface, <= 100 m
# below 3 km, growing to ~500 m aloft (generated by generate_rcemip_inputs.py)
erf.terrain_z_levels = 0.000 50.000 102.250 156.851 213.910 273.535 335.845 400.958 469.001 540.106 614.410 692.059 773.202 857.996 946.605 1039.203 1135.967 1235.967 1335.967 1435.967 1535.967 1635.967 1735.967 1835.967 1935.967 2035.967 2135.967 2235.967 2335.967 2435.967 2535.967 2635.967 2735.967 2835.967 2935.967 3035.967 3143.967 3260.607 3386.578 3522.627 3669.560 3828.247 3999.630 4184.723 4384.623 4600.516 4833.679 5085.496 5357.459 5651.178 5968.395 6310.989 6680.991 7080.593 7512.163 7978.259 8478.694 8979.129 9479.563 9979.998 10480.433 10980.868 11481.303 11981.738 12482.172 12982.607 13483.042 13983.477 14483.912 14984.346 15484.781 15985.216 16485.651 16986.086 17486.521 17986.955 18487.390 18987.825 19488.260 19988.695 20489.129 20989.564 21489.999 21990.434 22490.869 22991.304 23491.738 23992.173 24492.608 24993.043 25493.478 25993.913 26494.347 26994.782 27495.217 27995.652 28496.087 28996.521 29496.956 29997.391 30497.826 30998.261 31498.696 31999.130 32499.565 33000.000

# TIME STEP
erf.fixed_dt      = 6.0
# erf.fixed_fast_dt is unused in anelastic mode (no acoustic substepping)

# DIAGNOSTICS & VERBOSITY
erf.sum_interval = 100
erf.v            = 1
amr.v            = 1

# CHECKPOINT / PLOTFILES (14400 steps = 1 simulated day)
erf.check_file  = chk
erf.check_int   = 14400
erf.plot_file_1 = plt
erf.plot_int_1  = 14400
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure theta temp qv qc qi qrain qsnow qgraup

# SOLVER CHOICE
erf.use_gravity  = true
erf.use_coriolis = false         # RCEMIP: no rotation

# Anelastic solver (requires a build with ERF_ENABLE_FFT=ON). This matches
# standard RCE CRM practice (e.g. SAM). It is also required here in practice:
# the compressible acoustic-substepping path is unstable on this stretched
# vertical grid (a 2-dx computational mode in w grows from rest and crashes
# the run within ~20 steps, for any beta_s and fast_dt; the same setup with a
# uniform vertical grid is stable) -- candidate upstream bug.
erf.anelastic = 1

erf.moisture_model = "SAM"       # single-moment microphysics with ice

erf.molec_diff_type = "None"
erf.les_type        = "Smagorinsky"
erf.Cs              = 0.25
# Anisotropic mixing lengths (vertical filter width = dz, horizontal =
# sqrt(dx*dy)). Required on this grid: with the default isotropic
# (dx*dy*dz)^(1/3) ~ 368 m, the vertical eddy viscosity in convective plumes
# violates the explicit vertical-diffusion stability limit (K dt/dz^2 > 0.5
# at dz = 50 m, dt = 6 s) and the run blows up at convection onset.
erf.mix_isotropic   = false

# Upwinded advection (implicit scale-selective dissipation). With centered
# advection a 2-dx computational mode in w, pumped by the initially unstable
# surface layer, grows exponentially and crashes the run within minutes.
# Scalars use WENO: with non-monotone upwinding, advection overshoots on the
# sharp qv gradients of onset-stage grid-scale convection create spurious
# supersaturation extrema (qv approaching 2x qsat), whose condensation
# heating drives a runaway updraft that crashes the microphysics.
erf.dycore_horiz_adv_type    = Upwind_3rd
erf.dycore_vert_adv_type     = Upwind_3rd
erf.dryscal_horiz_adv_type   = WENOZ5
erf.dryscal_vert_adv_type    = WENOZ5
erf.moistscal_horiz_adv_type = WENOZ5
erf.moistscal_vert_adv_type  = WENOZ5

# INITIALIZATION: analytic RCEMIP sounding (Wing et al. 2018, Eqs. 2-6)
erf.init_type           = "input_sounding"
erf.input_sounding_file = "input_sounding_rcemip_sst300"
erf.sounding_type       = "Ideal"

# RCEMIP symmetry-breaking thermal noise (protocol Sec. 3.2.3): amplitude
# 0.1 K in the lowest model layer, decreasing linearly to 0.02 K in layer 5
prob.T_pert_amp_bottom = 0.10    # [K]
prob.T_pert_amp_top    = 0.02    # [K]
prob.T_pert_num_layers = 5

# SURFACE LAYER: saturated surface with fixed SST and constant roughness.
# The surface is an ocean, but we run it through ERF's "land" code path
# (erf.is_land = 1) with an explicitly prescribed qsat(SST): with fixed SST
# the saturation humidity is constant anyway, and the sea path's
# wind-dependent roughness (Charnock/Donelan/COARE) diverges at cold start
# with RCEMIP's zero-wind initial state (z0/ustar iteration as ustar -> 0).
# On restart from a spun-up state you can switch to erf.is_land = 0 with
# erf.most.roughness_type_sea = "charnock" for sea-state roughness; q_surf
# then updates to qsat automatically.
erf.is_land            = 1
erf.most.surf_temp     = 300.0     # SST [K]
erf.most.surf_moist    = 0.021953  # qsat(SST, p0) [kg/kg]; see generator output
erf.most.zref          = 25.0      # first cell center [m]
erf.most.z0            = 0.0002    # ocean roughness length [m]
erf.most.include_wstar = true      # convective gustiness in the weak-wind limit
                                   # (ERF analog of the protocol's 1 m/s floor)
erf.most.pblh_calc     = "MYNN25"  # PBL-height estimator: required by
                                   # include_wstar (w* ~ (g/thv * hfx * pblh)^1/3;
                                   # without it pblh stays at its 1e30 sentinel)

# RAYLEIGH DAMPING near the model top (gravity-wave absorber above 25 km)
erf.rayleigh_damp_U   = true
erf.rayleigh_damp_V   = true
erf.rayleigh_damp_W   = true
erf.rayleigh_damp_T   = false
erf.rayleigh_dampcoef = 0.01     # [1/s]
erf.rayleigh_zdamp    = 8000.    # depth of damping layer below the top [m]

# RADIATION: RRTMGP with RCEMIP insolation and trace gases
start_datetime             = "2000-01-01 00:00:00"
erf.radiation_model        = "RRTMGP"
erf.rad_freq_in_steps      = 10        # every 60 s
erf.rad_t_sfc              = 300.0     # = SST
erf.rad_sfc_albedo         = 0.07      # RCEMIP ocean albedo
erf.fixed_total_solar_irradiance = 551.58
erf.fixed_solar_zenith_angle     = 0.7425606   # cos(42.05 deg) -> S0*mu0 = 409.6 W/m2
erf.co2vmr = 348.0e-6
erf.ch4vmr = 1650.0e-9
erf.n2ovmr = 306.0e-9
erf.covmr  = 0.0                 # RCEMIP: no trace gases other than CO2/CH4/N2O/O3
erf.o2vmr  = 0.209448
erf.n2vmr  = 0.7906
erf.rad_do_subcol_sampling = true
erf.rad_write_fluxes       = false

# RCEMIP ozone profile (Wing et al. 2018 Eq. 1) at the 105 cell centers, bottom-up
erf.o3vmr = 2.221585e-42 3.688688e-42 6.250151e-42 1.081480e-41 1.912319e-41 3.458006e-41 6.399241e-41 1.212790e-40 2.355689e-40 4.692965e-40 9.596163e-40 2.015546e-39 4.351671e-39 9.665145e-39 2.209875e-38 5.205310e-38 1.257719e-37 3.057764e-37 7.372284e-37 1.762801e-36 4.180546e-36 9.833683e-36 2.294446e-35 5.310587e-35 1.219369e-34 2.777669e-34 6.277732e-34 1.407752e-33 3.132387e-33 6.916305e-33 1.515467e-32 3.295463e-32 7.112261e-32 1.523505e-31 3.239279e-31 7.042945e-31 1.615018e-30 3.917063e-30 1.007754e-29 2.758067e-29 8.052652e-29 2.515047e-28 8.424772e-28 3.034056e-27 1.177281e-26 4.930841e-26 2.232326e-25 1.093397e-24 5.795584e-24 3.322827e-23 2.057877e-22 1.373407e-21 9.842480e-21 7.537269e-20 6.128568e-19 5.215482e-18 4.243211e-17 3.067320e-16 1.979738e-15 1.146300e-14 5.981755e-14 2.825770e-13 1.213674e-12 4.759329e-12 1.710931e-11 5.660710e-11 1.730271e-10 4.904122e-10 1.293474e-09 3.180638e-09 7.246662e-09 1.536140e-08 3.047352e-08 5.687724e-08 1.003729e-07 1.682368e-07 2.689424e-07 4.116150e-07 6.052623e-07 8.578663e-07 1.175463e-06 1.561342e-06 2.015469e-06 2.534228e-06 3.110483e-06 3.733956e-06 4.391858e-06 5.069680e-06 5.752065e-06 6.423662e-06 7.069897e-06 7.677608e-06 8.235519e-06 8.734537e-06 9.167897e-06 9.531150e-06 9.822047e-06 1.004034e-05 1.018749e-05 1.026644e-05 1.028124e-05 1.023680e-05 1.013862e-05 9.992515e-06 9.804455e-06

