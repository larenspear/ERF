erf.rrtmgp_file_path       = ../../../Submodules/RRTMGP
erf.rrtmgp_coeffs_sw       = rrtmgp/data/rrtmgp-data-sw-g224-2018-12-04.nc
erf.rrtmgp_coeffs_lw       = rrtmgp/data/rrtmgp-data-lw-g256-2018-12-04.nc
erf.rrtmgp_cloud_optics_sw = extensions/cloud_optics/rrtmgp-cloud-optics-coeffs-sw.nc
erf.rrtmgp_cloud_optics_lw = extensions/cloud_optics/rrtmgp-cloud-optics-coeffs-lw.nc
