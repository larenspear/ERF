# Small deterministic derivative of SDM_Box3D_VTerm.
erf.prob_name = Bubble
erf.init_type = Isentropic
max_step = 2
stop_time = 3600
erf.fix_random_seed = 1
amrex.fpe_trap_invalid = 1
geometry.prob_lo = 0 0 0
geometry.prob_hi = 8 8 8
amr.n_cell = 8 8 8
amr.max_grid_size = 8
amr.blocking_factor = 2
geometry.is_periodic = 1 1 0
zlo.type = SlipWall
zhi.type = SlipWall
erf.fixed_dt = 0.001
erf.substepping_type = None
erf.sum_interval = 1
erf.v = 1
amr.v = 1
amr.max_level = 0
erf.check_file = chk
erf.check_int = 1
erf.plot_int_1 = -1
erf.plot_int_2 = -1
erf.use_gravity = true
erf.dycore_horiz_adv_type = Upwind_3rd
erf.dycore_vert_adv_type = Upwind_3rd
erf.dryscal_horiz_adv_type = Upwind_3rd
erf.dryscal_vert_adv_type = Upwind_3rd
erf.moistscal_horiz_adv_type = Upwind_3rd
erf.moistscal_vert_adv_type = Upwind_3rd
erf.les_type = None
erf.pbl_type = None
erf.moisture_model = SuperDroplets
erf.buoyancy_type = 1
erf.molec_diff_type = ConstantAlpha
erf.rho0_trans = 1
erf.alpha_T = 0
erf.alpha_C = 0
prob.T_0 = 300
prob.T_pert = 0
prob.do_moist_bubble = false
super_droplets_moisture.stable_redistribute = true
super_droplets_moisture.place_randomly_in_cells = false
super_droplets_moisture.distribution_type = uniform
super_droplets_moisture.diagnostics_interval = 1
super_droplets_moisture.include_coalescence = false
super_droplets_moisture.include_phase_change = false
super_droplets_moisture.include_cold_processes = true
super_droplets_moisture.advect_with_flow = false
super_droplets_moisture.advect_with_gravity = true
super_droplets_moisture.aerosols = NaCl NH42SO4
super_droplets_moisture.multiplicity_type = constant
super_droplets_moisture.initial_aerosol_distribution_type_NaCl = mass_constant
super_droplets_moisture.initial_aerosol_mean_mass_NaCl = 1e-12
super_droplets_moisture.initial_species_distribution_type_H2O = mass_constant
super_droplets_moisture.initial_species_mean_mass_H2O = 4.1887902e-9
super_droplets_moisture.initial_species_distribution_type_ice = mass_constant
super_droplets_moisture.initial_species_mean_mass_ice = 1e-9
super_droplets_moisture.initial_number_density = 100
super_droplets_moisture.initial_particles_per_cell = 1
particles.disable_plt = true

# Two independent nonwater species and two aerosol components.
super_droplets_moisture.species = water agua
super_droplets_moisture.initial_species_distribution_type_water = mass_constant
super_droplets_moisture.initial_species_mean_mass_water = 1e-9
super_droplets_moisture.initial_species_distribution_type_agua = mass_constant
super_droplets_moisture.initial_species_mean_mass_agua = 2e-9
super_droplets_moisture.initial_aerosol_distribution_type_NH42SO4 = mass_constant
super_droplets_moisture.initial_aerosol_mean_mass_NH42SO4 = 2e-12
